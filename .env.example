# Horizon local backend: copy to `.env` (git-ignored) and fill in what you need. Never commit `.env`.
# Precedence for every setting: environment > .env > data/settings.local.json > seed/settings.json.

# Your OpenRouter key (https://openrouter.ai/keys). Leave blank to stay in demo mode or to set it from Settings.
# While this is set, the key can't be changed from the UI. Test mode (HORIZON_TEST=1) ignores it.
OPENROUTER_API_KEY=

# Data directory (database, secrets file, generated assets, logs). Default: <repo>/data
# HORIZON_DATA_DIR=
# Seed directory. Default: <repo>/seed
# HORIZON_SEED_DIR=
# Time zone for "today" (daily cap, energy day). Default: Asia/Kuala_Lumpur
HORIZON_TZ=Asia/Kuala_Lumpur
# API port on 127.0.0.1 (loopback only). Default: 8000
HORIZON_PORT=8000
# DEBUG | INFO | WARNING | ERROR. Default: INFO
HORIZON_LOG_LEVEL=INFO
# Built frontend served by `horizon serve` (npm run demo). Default: unset
# HORIZON_STATIC_DIR=
# 1 = test mode: /_test/* routes, response validation, the in-process fake OpenRouter. Never set this for normal use.
# HORIZON_TEST=

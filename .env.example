# Horizon local backend: copy to `.env` (git-ignored) and fill in what you need. Never commit `.env`.
# Precedence for every setting: environment > .env > data/settings.local.json > seed/settings.json.

# Your OpenRouter key (https://openrouter.ai/keys). Leave blank to stay in demo mode or to set it from Settings.
# While this is set, the key can't be changed from the UI. Test mode (HORIZON_TEST=1) ignores it.
OPENROUTER_API_KEY=

# Root that `.env` and the default data/seed paths are resolved from. Default: this repository. Tests and tools only.
# HORIZON_ROOT=
# Data directory (database, secrets file, generated assets, logs). Default: <repo>/data
# HORIZON_DATA_DIR=
# Seed directory. Default: <repo>/seed
# HORIZON_SEED_DIR=
# Time zone for "today" (daily cap, energy day). Default: Asia/Kuala_Lumpur
HORIZON_TZ=Asia/Kuala_Lumpur

# ── Ports ───────────────────────────────────────────────────────────────
# THE one place both servers get their ports. If something else already uses one, change the number here and restart:
# the backend reads HORIZON_PORT, and the app's dev server (frontend/vite.config.ts) reads THIS FILE for both
# HORIZON_WEB_PORT (the page you open) and HORIZON_PORT (where it forwards /api to). No command line, no second file.
# A taken HORIZON_PORT stops the backend with a message naming this setting; a taken HORIZON_WEB_PORT moves the dev
# server to the next free port, and it prints the URL to open.
#
# The backend: API, live updates and generated images, on 127.0.0.1 only (it refuses any other address).
# `npm run demo` serves the whole app on this port too. Default: 8000
HORIZON_PORT=8000
# The page you open in `npm run dev` and `npm run dev:mock`. Default: 5173
HORIZON_WEB_PORT=5173

# DEBUG | INFO | WARNING | ERROR. Default: INFO
HORIZON_LOG_LEVEL=INFO
# Built frontend served by `horizon serve` (npm run demo). Default: unset
# HORIZON_STATIC_DIR=
# 1 = test mode: /_test/* routes, response validation, the in-process fake OpenRouter. Never set this for normal use.
# HORIZON_TEST=

# AI profile (docs/backend/05): `agent` (Jev decides, DeepSeek speaks), `naive` (the baseline: plain DeepSeek replies,
# the Jev router) or `scripted` (deterministic, no paid calls). Default: `agent` when a key is set, `scripted` otherwise.
# Each port below can override it; ports without an implementation in the chosen profile fall back (the backend's
# start-up log lists what every port resolved to). Leave these unset for normal use.
# HORIZON_AI_PROFILE=
# HORIZON_AI_TURN=
# HORIZON_AI_ROUTER=
# HORIZON_AI_REACTIONS=
# HORIZON_AI_HOST=
# HORIZON_AI_DIRECTOR=
# HORIZON_AI_SUMMARISER=
# HORIZON_AI_GUARDRAIL=
# HORIZON_AI_DRAFTER=
# HORIZON_AI_IMAGE=
# HORIZON_AI_SONG=
# HORIZON_AI_EMBEDDER=
# HORIZON_AI_KNOWLEDGE_RETRIEVER=
# HORIZON_AI_MEMORY_RETRIEVER=
# HORIZON_AI_MEMORY_WRITER=
# HORIZON_AI_CONVERTER=
# HORIZON_AI_PLANNER=
# HORIZON_AI_FACE_CHECK=

# AI call capture (docs/ai/02 B10): 1 = keep every AI call's redacted prompt and reply, and one row per turn, in the
# local ai_calls table for 7 days (for `horizon eval capture <messageId>`). Off by default; Forget and deletes clear it.
# HORIZON_CAPTURE_AI_CALLS=
# LangSmith tracing (docs/ai/02 B11): off and forced off unless HORIZON_LANGSMITH=1. Opting in SENDS chat and document
# text to LangSmith (an NFR-13 exception) and needs a LangSmith key plus the optional package:
# `uv sync --project backend --group tracing`.
# HORIZON_LANGSMITH=
# LANGSMITH_API_KEY=

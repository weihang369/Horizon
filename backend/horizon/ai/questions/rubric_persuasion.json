    "quoted_motion": "quoted",
    "quoted_criteria": "quoted",
    "quoted_sides": "quoted",
    "quoted_moderator": "quoted"
  },
  "deadline": "rubric",
  "floor": null,
  "thresholds": {
    "margin": 0.25
  },
  "fallback": "summary_only"
}

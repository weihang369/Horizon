{
  "schemaVersion": 1,
  "description": "Energy maths shared by frontend/src/domain/energy.ts and backend domain/energy.py (doc backend/04 §4, D-76, D-78). Hand-written expectations; see README.md.",
  "tolerance": 1e-6,
  "dayUtcOffsetMin": 480,
  "cases": [
    { "name": "pointsForCost: exact 5 points despite float noise", "fn": "pointsForCost", "args": { "costUsd": 0.0005, "usdPerPoint": 0.0001 }, "expected": 5 },
    { "name": "pointsForCost: rounds up", "fn": "pointsForCost", "args": { "costUsd": 0.00041, "usdPerPoint": 0.0001 }, "expected": 5 },
    { "name": "pointsForCost: doc 05 §8 worked example", "fn": "pointsForCost", "args": { "costUsd": 0.000424, "usdPerPoint": 0.0001 }, "expected": 5 },
    { "name": "pointsForCost: one point", "fn": "pointsForCost", "args": { "costUsd": 0.0001, "usdPerPoint": 0.0001 }, "expected": 1 },
    { "name": "pointsForCost: zero cost", "fn": "pointsForCost", "args": { "costUsd": 0, "usdPerPoint": 0.0001 }, "expected": 0 },
    { "name": "pointsForCost: negative cost is free", "fn": "pointsForCost", "args": { "costUsd": -0.01, "usdPerPoint": 0.0001 }, "expected": 0 },

    { "name": "regenAt: half a day refills half", "fn": "regenAt",
      "args": { "energy": { "current": 0, "max": 1000, "asOf": "2026-10-01T00:00:00.000Z", "regenPerHour": 41.666666666666664 }, "now": "2026-10-01T12:00:00.000Z" },
      "expected": 500 },
    { "name": "regenAt: caps at max", "fn": "regenAt",
      "args": { "energy": { "current": 0, "max": 1000, "asOf": "2026-10-01T00:00:00.000Z", "regenPerHour": 41.666666666666664 }, "now": "2026-10-02T06:00:00.000Z" },
      "expected": 1000 },
    { "name": "regenAt: keeps fractions (REAL storage)", "fn": "regenAt",
      "args": { "energy": { "current": 250.5, "max": 1000, "asOf": "2026-10-01T00:00:00.000Z", "regenPerHour": 41.666666666666664 }, "now": "2026-10-01T01:00:00.000Z" },
      "expected": 292.1666666666667 },
    { "name": "regenAt: a top-up above max is never lowered", "fn": "regenAt",
      "args": { "energy": { "current": 1400, "max": 1000, "asOf": "2026-10-01T00:00:00.000Z", "regenPerHour": 41.666666666666664 }, "now": "2026-10-01T05:00:00.000Z" },
      "expected": 1400 },
    { "name": "regenAt: asOf in the future adds nothing", "fn": "regenAt",
      "args": { "energy": { "current": 100, "max": 1000, "asOf": "2026-10-01T05:00:00.000Z", "regenPerHour": 41.666666666666664 }, "now": "2026-10-01T04:00:00.000Z" },
      "expected": 100 },

    { "name": "energyState: 6 ⚡ off-peak is tired (D-78)", "fn": "energyState", "args": { "current": 6, "max": 1000, "estReplyPoints": 4 }, "expected": "tired" },
    { "name": "energyState: 6 ⚡ at peak is exhausted (D-78)", "fn": "energyState", "args": { "current": 6, "max": 1000, "estReplyPoints": 8 }, "expected": "exhausted" },
    { "name": "energyState: just below the threshold", "fn": "energyState", "args": { "current": 3.99, "max": 1000, "estReplyPoints": 4 }, "expected": "exhausted" },
    { "name": "energyState: exactly the threshold can speak", "fn": "energyState", "args": { "current": 4, "max": 1000, "estReplyPoints": 4 }, "expected": "tired" },
    { "name": "energyState: just below 20 %", "fn": "energyState", "args": { "current": 199.99, "max": 1000, "estReplyPoints": 4 }, "expected": "tired" },
    { "name": "energyState: 20 % is active", "fn": "energyState", "args": { "current": 200, "max": 1000, "estReplyPoints": 4 }, "expected": "active" },
    { "name": "energyState: empty at peak", "fn": "energyState", "args": { "current": 0, "max": 1000, "estReplyPoints": 8 }, "expected": "exhausted" },

    { "name": "drain: simple", "fn": "drain",
      "args": { "energy": { "max": 1000, "current": 747, "asOf": "2026-10-01T04:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "active", "spentToday": 0 }, "points": 5, "now": "2026-10-01T04:00:00.000Z", "estReplyPoints": 4 },
      "expected": { "current": 742, "spentToday": 5, "state": "active", "asOf": "2026-10-01T04:00:00.000Z" } },
    { "name": "drain: regen first, fractions kept", "fn": "drain",
      "args": { "energy": { "max": 1000, "current": 100, "asOf": "2026-10-01T04:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "tired", "spentToday": 2 }, "points": 5, "now": "2026-10-01T05:00:00.000Z", "estReplyPoints": 4 },
      "expected": { "current": 136.66666666666666, "spentToday": 7, "state": "tired", "asOf": "2026-10-01T05:00:00.000Z" } },
    { "name": "drain: overdraft clamps at 0 and still counts the spend", "fn": "drain",
      "args": { "energy": { "max": 1000, "current": 3, "asOf": "2026-10-01T04:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "exhausted", "spentToday": 0 }, "points": 10, "now": "2026-10-01T04:00:00.000Z", "estReplyPoints": 4 },
      "expected": { "current": 0, "spentToday": 10, "state": "exhausted" } },
    { "name": "drain: lands on the peak threshold", "fn": "drain",
      "args": { "energy": { "max": 1000, "current": 15, "asOf": "2026-10-01T04:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "tired", "spentToday": 0 }, "points": 8, "now": "2026-10-01T04:00:00.000Z", "estReplyPoints": 8 },
      "expected": { "current": 7, "spentToday": 8, "state": "exhausted" } },

    { "name": "topUp: may exceed max", "fn": "topUp",
      "args": { "energy": { "max": 1000, "current": 900, "asOf": "2026-10-01T04:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "active", "spentToday": 0 }, "points": 500, "now": "2026-10-01T04:00:00.000Z", "estReplyPoints": 4 },
      "expected": { "current": 1400, "state": "active", "spentToday": 0 } },
    { "name": "topUp: wakes an exhausted character", "fn": "topUp",
      "args": { "energy": { "max": 1000, "current": 0, "asOf": "2026-10-01T04:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "exhausted", "spentToday": 40 }, "points": 500, "now": "2026-10-01T04:00:00.000Z", "estReplyPoints": 8 },
      "expected": { "current": 500, "state": "active", "spentToday": 40 } },

    { "name": "settle: day roll at MYT midnight resets spentToday", "fn": "settle",
      "args": { "energy": { "max": 1000, "current": 500, "asOf": "2026-10-02T15:59:00.000Z", "regenPerHour": 41.666666666666664, "state": "active", "spentToday": 37 }, "now": "2026-10-02T16:01:00.000Z", "estReplyPoints": 4 },
      "expected": { "spentToday": 0, "current": 501.3888888888889, "asOf": "2026-10-02T16:01:00.000Z" } },
    { "name": "settle: same MYT day keeps spentToday", "fn": "settle",
      "args": { "energy": { "max": 1000, "current": 500, "asOf": "2026-10-02T01:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "active", "spentToday": 37 }, "now": "2026-10-02T15:59:00.000Z", "estReplyPoints": 4 },
      "expected": { "spentToday": 37, "current": 1000 } },
    { "name": "settle: frozen (demo mode) changes nothing but state", "fn": "settle",
      "args": { "energy": { "max": 1000, "current": 6, "asOf": "2026-10-01T00:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "tired", "spentToday": 3 }, "now": "2026-10-03T00:00:00.000Z", "estReplyPoints": 8, "frozen": true },
      "expected": { "current": 6, "spentToday": 3, "asOf": "2026-10-01T00:00:00.000Z", "state": "exhausted" } },

    { "name": "dayRoll: across midnight", "fn": "dayRoll",
      "args": { "energy": { "max": 1000, "current": 10, "asOf": "2026-10-02T15:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "active", "spentToday": 99 }, "now": "2026-10-02T16:00:00.000Z" },
      "expected": { "spentToday": 0, "current": 10, "asOf": "2026-10-02T15:00:00.000Z" } },
    { "name": "dayRoll: UTC midnight is not the boundary", "fn": "dayRoll",
      "args": { "energy": { "max": 1000, "current": 10, "asOf": "2026-10-02T23:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "active", "spentToday": 99 }, "now": "2026-10-03T01:00:00.000Z" },
      "expected": { "spentToday": 99 } },

    { "name": "canTopUp: first +5000 fits ($0.10 spent, $1 cap)", "fn": "canTopUp",
      "args": { "spentTodayUsd": 0.1, "todayTopUpPoints": 0, "points": 5000, "usdPerPoint": 0.0001, "dailyCapUsd": 1 }, "expected": true },
    { "name": "canTopUp: second +5000 is refused (D-76)", "fn": "canTopUp",
      "args": { "spentTodayUsd": 0.1, "todayTopUpPoints": 5000, "points": 5000, "usdPerPoint": 0.0001, "dailyCapUsd": 1 }, "expected": false },
    { "name": "canTopUp: exactly the cap is allowed", "fn": "canTopUp",
      "args": { "spentTodayUsd": 0.5, "todayTopUpPoints": 0, "points": 5000, "usdPerPoint": 0.0001, "dailyCapUsd": 1 }, "expected": true },
    { "name": "canTopUp: a cap already reached refuses any top-up", "fn": "canTopUp",
      "args": { "spentTodayUsd": 1, "todayTopUpPoints": 0, "points": 500, "usdPerPoint": 0.0001, "dailyCapUsd": 1 }, "expected": false },

    { "name": "toWireEnergy: floors current and spentToday only", "fn": "toWireEnergy",
      "args": { "energy": { "max": 1000, "current": 500.17, "asOf": "2026-10-01T00:00:00.000Z", "regenPerHour": 41.666666666666664, "state": "active", "spentToday": 12.9 } },
      "expected": { "current": 500, "spentToday": 12, "max": 1000, "regenPerHour": 41.666666666666664, "state": "active" } }
  ]
}

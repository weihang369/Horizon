      "worldId": "wld_seedMeridian",
      "kind": "fact",
      "text": "Amara told Kai his temple headache is likely caffeine withdrawal, fitting the usual three-day timeline.",
      "importance": 0.405,
      "sourceSessionId": "ses_seedAmaraHeadache",
      "sourceMessageId": "msg_seedA05",

        "summary": [
          {
            "subjectId": "prop",
            "points": [
              "Four-day week is not compressed longer days; it cuts burnout by breaking consecutive blocks.",
              "Rested staff are safer: under-six-hours sleep doubled near-miss medication errors.",
              "Nationwide means a legislated default, not one identical rota, with a transition.",
              "The machinery exists in continuous-coverage sectors under the Working Time Code.",
              "Trials written into the statute with sunset review; adopt the default, phase the rollout."
            ]
          },
          {
            "subjectId": "opp",
            "points": [
              "Pilot evidence is soft: fewer than half measured output consistently.",
              "Four-day weeks are a bundle of choices; hospitals and care cannot compress coverage.",
              "Nine shift-based organisations needed 18% to 27% more staffed hours to hold coverage.",
              "Only two of nine checked whether lower sickness and turnover clawed any back.",
              "Trials first, independently measured, both sides of the ledger, published including failures."
            ]
          }
        ],
        "keyDisagreement": "Whether 'we do not yet know' is a reason to legislate a default trajectory now or to run sector trials first, given both sides accept trials with sunset review.",

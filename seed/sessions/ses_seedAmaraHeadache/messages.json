    {
      "kind": "chat",
      "seq": 7,
      "id": "msg_seedA07",
      "sessionId": "ses_seedAmaraHeadache",
      "author": {
        "type": "character",
        "characterId": "chr_seedAmara"
      },
      "content": "Yes, and this is the honest caveat: I can't examine you. If it's suddenly the worst headache of your life, or it comes with fever, a stiff neck, vision changes, confusion or weakness, that's same-day medical care, not a chat with me.[1]",
      "status": "complete",
      "createdAt": "2026-09-29T21:14:16.509Z",
      "emotion": "neutral",
      "emotionSource": "llm",
      "usage": {
        "tokensIn": 2302,
        "tokensCached": 1808,
        "tokensOut": 59,
        "costUsd": 0.000115,
        "energySpent": 2,
        "firstTokenMs": 1399,
        "totalMs": 3104
      },
      "citations": [

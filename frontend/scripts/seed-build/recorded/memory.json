[
  {
    "id": "mem_01M5F0F1MVMY3JJ01B25BMF5A4",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "event",
    "text": "Kai described a three-day headache centered at the temples and said he cut back on coffee the week before.",
    "importance": 0.4725,
    "sourceSessionId": "ses_01M5F0CFENPXNN3WEBWGX07RYJ",
    "sourceMessageId": "msg_01M5F0CTA32M3XXXB5MYBG3P89",
    "createdAt": "2026-10-21T10:35:13.942Z"
  },
  {
    "id": "mem_01M5F0F1N5KYSY51S35EB27T9E",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Amara told Kai his temple headache is likely caffeine withdrawal, fitting the usual three-day timeline.",
    "importance": 0.405,
    "sourceSessionId": "ses_01M5F0CFENPXNN3WEBWGX07RYJ",
    "sourceMessageId": "msg_01M5F0DGZSTWD1EV80KNCVN6CD",
    "createdAt": "2026-10-21T10:35:13.942Z"
  },
  {
    "id": "mem_01M5F0F1N7658QRWBKG1AAG0SB",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Amara advised Kai to seek emergency care for thunderclap headache, fever, neck stiffness, confusion, weakness, vision changes, or stroke signs.",
    "importance": 0.6325,
    "sourceSessionId": "ses_01M5F0CFENPXNN3WEBWGX07RYJ",
    "sourceMessageId": "msg_01M5F0E6N6TQ0Z5TXBHNGVVEWD",
    "createdAt": "2026-10-21T10:35:13.942Z"
  },
  {
    "id": "mem_01M5F0F1NA2YRDC8VBBF983H3B",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Amara advised Kai that a headache waking him from sleep or after head injury needs same-day review.",
    "importance": 0.5025,
    "sourceSessionId": "ses_01M5F0CFENPXNN3WEBWGX07RYJ",
    "sourceMessageId": "msg_01M5F0E6N6TQ0Z5TXBHNGVVEWD",
    "createdAt": "2026-10-21T10:35:13.942Z"
  },
  {
    "id": "mem_01M5F2PA753EK21WPAAR6BKE6C",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "event",
    "text": "Amara argued a compressed rota with guaranteed rest days cut burnout about a fifth in twelve weeks, with patient throughput, length of stay and readmissions within normal variation.",
    "importance": 0.7275,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2M5H9793C2GSJXQ00J3X7",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA77Z3TZV8WS4M6BZZDP",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Amara reported ED burnout climbed from 29% to 41% in ten months, and staff sleeping under six hours before a shift were twice as likely to report near-miss medication errors.",
    "importance": 0.7375,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2M5H9793C2GSJXQ00J3X7",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA79WV8KCTDMEC2KMQHN",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Amara named Mei's sequencing point as strongest: thin output measurement means mandating now risks freezing the wrong model.",
    "importance": 0.615,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2MP88R1JZRZHS99E062RQ",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7ATMMSHP743FSG418K",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "event",
    "text": "Amara said the pilot wards' transition month needed 6% more agency hours before settling to baseline by week eight, with no extra staffed hours long-term.",
    "importance": 0.655,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2NCT57B3PT9CB1E72W5T3",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7BZC7B45ZXVWC63RW1",
    "characterId": "chr_seedAmara",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Amara advocated adopting a phased statutory default with sector trials and sunset review written into the statute.",
    "importance": 0.7225,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2NCT57B3PT9CB1E72W5T3",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F27QACJMF5C0TXJH0218YP",
    "characterId": "chr_seedHana",
    "worldId": "wld_seedSunnyHollow",
    "kind": "event",
    "text": "Hana fixed the wheezing fridge display, but the broken vase was her favorite cream one with the crackle glaze, now in the bin.",
    "importance": 0.5325,
    "sourceSessionId": "ses_01M5F250JD0GA1AYNJBGAESPSJ",
    "sourceMessageId": "msg_01M5F26S51ASDHA8AE9WK3KXV3",
    "createdAt": "2026-10-21T11:06:11.144Z"
  },
  {
    "id": "mem_01M5F27QAD2JK6FMVMPEHZAVQ4",
    "characterId": "chr_seedHana",
    "worldId": "wld_seedSunnyHollow",
    "kind": "event",
    "text": "Hana made Kai tea when Kai came home after a long day.",
    "importance": 0.3725,
    "sourceSessionId": "ses_01M5F250JD0GA1AYNJBGAESPSJ",
    "sourceMessageId": "msg_01M5F25D23WQY2KYKQR40YN54H",
    "createdAt": "2026-10-21T11:06:11.144Z"
  },
  {
    "id": "mem_01M5F27QAFTKDTP0ZSFF90N95C",
    "characterId": "chr_seedHana",
    "worldId": "wld_seedSunnyHollow",
    "kind": "event",
    "text": "Hana's shop day was mostly quiet: a birthday bouquet for a regular and a delivery she almost dropped.",
    "importance": 0.29,
    "sourceSessionId": "ses_01M5F250JD0GA1AYNJBGAESPSJ",
    "sourceMessageId": "msg_01M5F261WH5DZ5MM7R058SS0E0",
    "createdAt": "2026-10-21T11:06:11.144Z"
  },
  {
    "id": "mem_01M5F2PA7N7SYQVR7M4MGERD37",
    "characterId": "chr_seedMei",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Mei argued pilots show burnout down about a third and sick days down a fifth, but fewer than half the firms measured output consistently.",
    "importance": 0.6575,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2M5G70CZFPGNKREC5TY98",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7Q9186Z47DY33ZXVWH",
    "characterId": "chr_seedMei",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Mei argued a national mandate would freeze one model before knowing which sectors it breaks, and managers absorbed coordination costs in pilots.",
    "importance": 0.6975,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2M5G70CZFPGNKREC5TY98",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7RRH0YXH1R0XF87STX",
    "characterId": "chr_seedMei",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Mei named Amara's sequencing point as strongest: phased because we don't know yet is not phased because we do.",
    "importance": 0.6525,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2MZ48K8ADT0B3EE772HTG",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7V2ZQS3AZFVBFNYFN7",
    "characterId": "chr_seedMei",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Mei argued trials should be randomised where possible, in an acute trust, transport operator and residential care, published including failures.",
    "importance": 0.7125,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2MZ48K8ADT0B3EE772HTG",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7WY22KHW742ZY2206Q",
    "characterId": "chr_seedMei",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Mei argued the recurring cost is unresolved: one month in a ward is not nine sectors at scale, and a two-week planning period is a transition.",
    "importance": 0.7125,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2NJRTTN0YFYY2QMP3VK3R",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F0APCBXCCJ8ZTCY8WKEBD1",
    "characterId": "chr_seedRin",
    "worldId": "wld_seedSunnyHollow",
    "kind": "preference",
    "text": "Rin dislikes being awake before ten on Sundays, but cut this trip to fifteen minutes and doesn't waste daylight.",
    "importance": 0.61,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F09S391A3M5M1XBKN1B826",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APCBXCCJ8ZTCY8WKEBD2",
    "characterId": "chr_seedRin",
    "worldId": "wld_seedSunnyHollow",
    "kind": "fact",
    "text": "Rin admits when she says five minutes she means twenty, and she holds Takeshi to her own terrible math for once.",
    "importance": 0.62,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F09DCN5B7XXHH2XQX451WK",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APCE5RC9B17A6E6HBTZD",
    "characterId": "chr_seedRin",
    "worldId": "wld_seedSunnyHollow",
    "kind": "event",
    "text": "Rin logged off mid-raid to go fishing after the last pull, saying her guild would kill her and they'd be right.",
    "importance": 0.5525,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F0AA3B064ZW33A6ZNCWP06",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APCE5RC9B17A6E6HBTZE",
    "characterId": "chr_seedRin",
    "worldId": "wld_seedSunnyHollow",
    "kind": "event",
    "text": "Takeshi set the Sunday fishing trip; Rin agreed, bringing coffee with no sugar in the thermos while Takeshi brings worms and baits both hooks.",
    "importance": 0.55,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F0A3F253ZRZERCMA1CBQSR",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APCE5RC9B17A6E6HBTZF",
    "characterId": "chr_seedRin",
    "worldId": "wld_seedSunnyHollow",
    "kind": "fact",
    "text": "Takeshi doesn't honk, saying horns are for emergencies and bad drivers, and jokes that Rin's IT 'ten' means right now.",
    "importance": 0.3975,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F0A63T3W6C27AG7ZFYMABG",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F1XQ136DTM793EA3HNV3V8",
    "characterId": "chr_seedRin",
    "worldId": "wld_seedSunnyHollow",
    "kind": "preference",
    "text": "Rin insists pineapple on sushi is a war crime, even with Takeshi calling it first class.",
    "importance": 0.4075,
    "sourceSessionId": "ses_01M5F1TFKABR0MXZQGX63EGEKT",
    "sourceMessageId": "msg_01M5F1WYG00RZSZ05XTH2S33KK",
    "createdAt": "2026-10-21T11:00:43.150Z"
  },
  {
    "id": "mem_01M5F0APC2YV567Z4MAFD330WD",
    "characterId": "chr_seedTakeshi",
    "worldId": "wld_seedSunnyHollow",
    "kind": "event",
    "text": "Rin agreed to a rainy-Sunday fishing trip; Takeshi brings worms and baits both hooks, Rin brings the thermos with coffee and no sugar.",
    "importance": 0.585,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F090XQYZHBNDAATWCJMAGW",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APC2YV567Z4MAFD330WE",
    "characterId": "chr_seedTakeshi",
    "worldId": "wld_seedSunnyHollow",
    "kind": "event",
    "text": "Rin's five minutes means twenty, and this time she cut it to fifteen; Takeshi counted in train time, which means exact.",
    "importance": 0.59,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F09XYBNVQDCT9SJ0JEKXE4",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APC2YV567Z4MAFD330WF",
    "characterId": "chr_seedTakeshi",
    "worldId": "wld_seedSunnyHollow",
    "kind": "preference",
    "text": "Rin hates waking before ten on Sundays and calls 0900 a war crime.",
    "importance": 0.5375,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F090XQYZHBNDAATWCJMAGW",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APC74HH5MH2VHTKMYMNE",
    "characterId": "chr_seedTakeshi",
    "worldId": "wld_seedSunnyHollow",
    "kind": "fact",
    "text": "Rin works in IT and is mid-raid; she logged off to go fishing, saying her guild would kill her for it.",
    "importance": 0.36,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F0AA3B064ZW33A6ZNCWP06",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F0APC74HH5MH2VHTKMYMNF",
    "characterId": "chr_seedTakeshi",
    "worldId": "wld_seedSunnyHollow",
    "kind": "fact",
    "text": "Sun after rain means trout go stupid-hungry, and the dock will be empty mud, which Rin says is the only fishing she respects.",
    "importance": 0.48,
    "sourceSessionId": "ses_01M5F08ZGJNQHXYZHNE1TRYK6Q",
    "sourceMessageId": "msg_01M5F09XYBNVQDCT9SJ0JEKXE4",
    "createdAt": "2026-10-21T10:32:51.322Z"
  },
  {
    "id": "mem_01M5F2PA7DYXE0CPDEXA7ZVXPC",
    "characterId": "chr_seedVictor",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Victor argued the status quo is itself a policy choice that must justify itself, so the burden is not on the motion alone.",
    "importance": 0.6775,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2M5GPJZA0692X9260JT8N",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7FGKBDFG0XNHV5R9KP",
    "characterId": "chr_seedVictor",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Victor argued 'nationwide' means a default standard in law with a transition, not one identical rota for every ward.",
    "importance": 0.61,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2M5GPJZA0692X9260JT8N",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7HH0C42XCBB2YD218C",
    "characterId": "chr_seedVictor",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Victor named Mei's covered-hours bill as strongest, but argued it is a gross figure only two of nine organisations netted against sickness, churn and agency spend.",
    "importance": 0.57,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2N539NP53SM4GW5GMZ0BR",
    "createdAt": "2026-10-21T11:14:09.249Z"
  },
  {
    "id": "mem_01M5F2PA7K1T49J9N3FKHBGJZA",
    "characterId": "chr_seedVictor",
    "worldId": "wld_seedMeridian",
    "kind": "fact",
    "text": "Victor argued the only live question is whether 'we do not yet know' justifies legislating a trajectory or never starting one.",
    "importance": 0.6675,
    "sourceSessionId": "ses_01M5F2M3W60E8V3WH18E2Y9PJQ",
    "sourceMessageId": "msg_01M5F2NQRN9T9HHDEH5KEQAMJ6",
    "createdAt": "2026-10-21T11:14:09.249Z"
  }
]

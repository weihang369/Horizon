{
  "name": "horizon-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:prod": "npm run build && playwright test",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "seed:build": "node scripts/seed-build/run.mjs build",
    "seed:check": "node scripts/seed-build/run.mjs check",
    "export-schema": "node scripts/export-schema/run.mjs",
    "export-schema:check": "node scripts/export-schema/run.mjs --check",
    "budget": "node scripts/budget.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
